# Copy this file to server/.env (backend) and client/.env (frontend) as
# noted below, then fill in real values. Never commit a real .env file.

# ---------------------------------------------------------------------------
# SERVER — copy the relevant keys below into server/.env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Matches docker-compose.yml's default postgres service.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/prescription_db?schema=public"

# Generate strong random values for these, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Set to "true" once serving over HTTPS (required for secure cookies in production).
COOKIE_SECURE=false
# COOKIE_DOMAIN=yourdomain.com

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

UPLOAD_DIR=uploads/prescriptions
MAX_UPLOAD_SIZE_MB=10

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# --- AI extraction provider (vision) -----------------------------------------
# Controls what actually reads an uploaded prescription image.
#
#   anthropic  Claude vision via the Anthropic API. Needs ANTHROPIC_API_KEY
#              (the same key as Scripty, below). SENDS THE PRESCRIPTION
#              IMAGE TO ANTHROPIC.
#   google     Gemini (or Gemma) via Google AI Studio. Needs GOOGLE_API_KEY.
#              SENDS THE PRESCRIPTION IMAGE TO GOOGLE.
#   xai        Grok vision via the xAI API. Needs XAI_API_KEY.
#              SENDS THE PRESCRIPTION IMAGE TO XAI.
#   ollama     Local Gemma 3 via Ollama. NO API KEY. The image never leaves
#              your machine (best for privacy; slow without a GPU).
#   mock       Fixed demo medicines, never reads the image. Automated tests
#              ONLY — the server refuses to start with it otherwise.
#
# There is no default: choosing which company sees a patient's prescription
# is a decision, so the server will not start until one is made. Live tests
# (scripts/extractionLive.ts) of anthropic and google on the same images
# are summarised in the README.
AI_PROVIDER=anthropic
# Optional second provider, tried ONLY when the first is out of quota, rate
# limited, overloaded or unreachable (never for an unreadable image).
# Naming one is the decision that images may also go to that company.
# Leave empty for no fallback. If its key is missing it is simply inactive.
AI_FALLBACK_PROVIDER=
# Claude model for reading images. Checked against the Models API at first
# use — a model without image input is refused.
ANTHROPIC_VISION_MODEL=claude-opus-5-5

# --- Local, no credentials -----------------------------------------------------
# Install Ollama (https://ollama.com/download), then: ollama pull gemma3:4b
# IMPORTANT: must be a multimodal model. Per Google's Gemma 3 model card,
# only 4B/12B/27B accept images — gemma3:1b and gemma3:270m are TEXT-ONLY
# and are rejected at runtime.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --- Google AI Studio ------------------------------------------------------------
# Get a key: https://aistudio.google.com/apikey
# NEVER commit a real key. This file holds placeholders only.
# GOOGLE_API_KEY=your-google-ai-studio-key-here
GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Must accept images. Gemini models get JSON response mode automatically.
GOOGLE_MODEL=gemini-3.5-flash

# --- xAI (Grok) ------------------------------------------------------------------
# Get a key: https://console.x.ai — NEVER commit a real key.
# XAI_API_KEY=your-xai-key-here
XAI_API_BASE_URL=https://api.x.ai/v1
# Must accept images; checked against xAI's model list before first use.
XAI_MODEL=grok-4

# Vision request limits. Transient overloads (HTTP 5xx) and per-minute rate
# limits are retried; an exhausted daily quota is not.
VISION_TIMEOUT_MS=120000
VISION_MAX_ATTEMPTS=3

# --- Schedules -----------------------------------------------------------------
# Default clock times for doses written relative to meals ("after breakfast")
# or as dose positions ("1+0+1"). The prescription states the meal; these
# only turn it into a time, which the user reviews before saving. HH:mm.
MEAL_TIME_BREAKFAST=08:00
MEAL_TIME_LUNCH=13:30
MEAL_TIME_DINNER=20:00
MEAL_TIME_BEDTIME=22:30

# --- Scripty (in-app AI assistant) -------------------------------------------
# Scripty is a Claude conversation with tool calling (Anthropic API). It is
# independent of the vision provider above. Without ANTHROPIC_API_KEY it
# reports "not configured" — there is no canned or mock fallback.
# Create a key at https://console.anthropic.com/settings/keys and put it in
# server/.env ONLY. NEVER commit a real key; this file holds a placeholder.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning depth: low (fastest, cheapest) | medium | high (most thorough).
SCRIPTY_EFFORT=medium
SCRIPTY_MAX_OUTPUT_TOKENS=16000
SCRIPTY_TIMEOUT_MS=90000
# Conversations live in server memory only (never written to the database)
# and expire after this many idle minutes.
SCRIPTY_CONVERSATION_TTL_MINUTES=120
# User messages per conversation before a new one must be started.
SCRIPTY_MAX_TURNS=30
# Messages per user per minute (cost and abuse backstop).
SCRIPTY_RATE_LIMIT_PER_MINUTE=12

# --- Medicine information (openFDA) ------------------------------------------
# openFDA (https://open.fda.gov/apis/drug/label/) is a documented, public
# domain U.S. FDA API and needs NO API KEY. It supplies US drug-label text
# only; the UI labels it as such. There is no permitted bulk source for
# Pakistani product leaflets or DRAP prices — see
# docs/medicine-data-sources.md before adding one.
MEDICINE_INFO_TIMEOUT_MS=15000
# Cached label text is refreshed after this many days.
MONOGRAPH_CACHE_DAYS=30
# A cached "no label found" is retried sooner, since coverage improves.
MONOGRAPH_MISS_CACHE_DAYS=7

# Confidence thresholds the extraction pipeline uses to add its own
# "needs scrutiny" warnings on top of the provider's own output. See the
# comment on these in server/src/config/env.ts before changing them.
CONFIDENCE_THRESHOLD_LOW=0.5
CONFIDENCE_THRESHOLD_HIGH=0.8

# Minimum name-similarity score (0..1) before a medicine_reference row
# counts as a match candidate at all.
MEDICINE_MATCH_MIN_SCORE=0.6

# --- Medicine catalogue --------------------------------------------------------
# Verified product photos imported by `npm run catalogue:images` live here.
MEDICINE_IMAGE_DIR=uploads/medicine-images
# Synthetic medicines (old seed rows, test fixtures) are hidden from users.
# Only the automated test config sets this to true. Leave it false.
CATALOGUE_INCLUDE_SYNTHETIC=false

# --- Reminder email delivery -------------------------------------------------
# "none" (default): reminders are tracked and shown in-app only; no email
# is ever sent, and every delivery attempt is explicitly recorded as
# SKIPPED_NOT_CONFIGURED (never a false "sent"). "smtp": sends real email
# via the SMTP settings below — works with any SMTP provider (a Gmail app
# password for local testing, or a transactional provider's SMTP relay —
# Resend, SendGrid, Mailgun, Postmark, etc.).
EMAIL_PROVIDER=none

# Required only when EMAIL_PROVIDER=smtp. Never commit real values.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM_EMAIL=reminders@example.com
# SMTP_FROM_NAME=Scriptly

# How often (seconds) the server scans for due reminders, and how many
# times it retries a failed send before giving up permanently on that
# reminder (a terminal FAILED record, not an infinite retry loop).
REMINDER_SCHEDULER_INTERVAL_SECONDS=60
REMINDER_EMAIL_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# CLIENT — copy the relevant keys below into client/.env
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:4000/api
